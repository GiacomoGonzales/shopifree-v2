# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=shopifree-7867e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shopifree-7867e
VITE_FIREBASE_STORAGE_BUCKET=shopifree-7867e.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Vercel (for subdomain creation - frontend)
VITE_VERCEL_PROJECT_ID=prj_YgKbAHmwKcCff31cek9QUWknSiAX
VITE_VERCEL_TOKEN=your_vercel_token

# Vercel (for custom domains - server API routes)
VERCEL_PROJECT_ID=prj_YgKbAHmwKcCff31cek9QUWknSiAX
VERCEL_TOKEN=your_vercel_token

# MercadoPago (optional, for payment integration)
VITE_MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key

# Platform Meta Pixel (shopifree.app's OWN acquisition funnel — NOT merchant pixels).
# Create it in Meta Events Manager and set the ID here + in Vercel env.
# Enables Lead / CompleteRegistration conversion events for META ad campaigns.
VITE_META_PIXEL_ID=your_meta_pixel_id


# ShopiChat (WhatsApp Cloud API, multi-tienda via Embedded Signup + Coexistencia)
# Server (Vercel, api/whatsapp.ts y api/whatsapp-webhook.ts). El token de cada
# tienda NO va aca: se guarda en stores/{storeId}/private/whatsapp al conectar.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Front (boton de Embedded Signup: FB.init appId + FB.login config_id)
VITE_META_APP_ID=
VITE_META_ES_CONFIG_ID=
# Lanzamiento publico de ShopiChat (hasta entonces solo lo ven los admins).
# Al lanzar, poner las DOS en 'true' en Vercel (Production) y redeployar:
#  - VITE_SHOPICHAT_PUBLIC: front (menu, landing, plan Business, ayuda).
#  - SHOPICHAT_PUBLIC: servidor (Sofia explica ShopiChat en vez de "proximamente").
VITE_SHOPICHAT_PUBLIC=false
SHOPICHAT_PUBLIC=false
