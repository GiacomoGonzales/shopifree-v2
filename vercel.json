{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "src/lib/**"
    }
  },
  "redirects": [
    {
      "source": "/:lang/blog/mejores-plataformas-ecommerce-gratis-2025",
      "destination": "/:lang/blog/mejores-plataformas-ecommerce-gratis-2026",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/v1/whatsapp/:path*", "destination": "/api/v1/whatsapp?route=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/send-email",
      "schedule": "0 14 * * *"
    }
  ]
}
