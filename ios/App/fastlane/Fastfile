# Fastfile — white-label iOS release lane for Shopifree store apps.
#
# Usage from CI:
#   fastlane release
#
# Expects env vars:
#   STORE_ID, BUILD_NUMBER, VERSION_NAME
#   APPSTORE_API_KEY_ID, APPSTORE_API_ISSUER_ID
#   APPLE_TEAM_ID, MATCH_GIT_URL, MATCH_PASSWORD, MATCH_GIT_BASIC_AUTHORIZATION
#
# The App Store Connect API key (.p8) is expected at
#   ~/.appstoreconnect/private_keys/AuthKey.p8
# (decoded by the workflow before fastlane runs).

default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Build and upload to TestFlight"
  lane :release do
    # 1) Authenticate to App Store Connect via API key (no Apple ID/2FA)
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_API_KEY_ID"],
      issuer_id: ENV["APPSTORE_API_ISSUER_ID"],
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey.p8"),
      in_house: false
    )

    # 2) Bundle id + app name come from the workflow (read from .build-meta.json).
    # Info.plist still has unexpanded $(PRODUCT_BUNDLE_IDENTIFIER) at this point,
    # so we can't read it from there — Capacitor writes the real value into
    # the Xcode project, and Xcode resolves it only at build time.
    bundle_id = ENV["BUNDLE_ID"]
    app_name  = ENV["APP_NAME"] || bundle_id
    UI.user_error!("BUNDLE_ID env var is missing") if bundle_id.nil? || bundle_id.empty?
    UI.message("Building bundle id: #{bundle_id}")

    # 3) Ensure the bundle id is registered in Developer Portal + App Store Connect.
    # We use Spaceship::ConnectAPI directly (token was set globally in step 1)
    # because `produce` in this fastlane version still requires an Apple ID
    # username, which would force interactive 2FA in CI.
    require "spaceship"

    UI.message("Checking Developer Portal for bundle id: #{bundle_id}")
    if Spaceship::ConnectAPI::BundleId.find(bundle_id).nil?
      UI.message("Registering bundle id in Developer Portal…")
      Spaceship::ConnectAPI::BundleId.create(
        name: app_name.gsub(/[^a-zA-Z0-9 ]/, "").strip,
        identifier: bundle_id,
        platform: "IOS"
      )
      UI.success("Bundle id registered: #{bundle_id}")
    else
      UI.message("Bundle id already registered.")
    end

    UI.message("Checking App Store Connect for app: #{bundle_id}")
    if Spaceship::ConnectAPI::App.find(bundle_id).nil?
      UI.user_error!(<<~MSG)
        App record not found in App Store Connect for bundle id '#{bundle_id}'.

        Apple no longer allows creating App Store Connect apps via API. You need
        to create it once in the web UI, then re-run this build:

          1. Go to https://appstoreconnect.apple.com/apps
          2. Click '+' → 'New App'
          3. Platform: iOS
             Name: #{app_name}
             Primary Language: English (U.S.) or the store's language
             Bundle ID: choose '#{bundle_id}' from the dropdown (already registered in Dev Portal)
             SKU: #{bundle_id.gsub('.', '_')}
             User Access: Full Access
          4. Save. Then trigger this build again.
      MSG
    else
      UI.message("App record already exists in App Store Connect.")
    end

    # 4) Sync signing certs + provisioning profiles via Match.
    # readonly=false so match can create a per-bundle provisioning profile
    # on first build of each store. The existing distribution cert in the
    # match repo is reused — match only ever creates missing profiles.
    match(
      type: "appstore",
      app_identifier: bundle_id,
      readonly: false,
      api_key: api_key
    )

    # 5) Bump build + version
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: ENV["BUILD_NUMBER"]
    )
    increment_version_number(
      xcodeproj: "App.xcodeproj",
      version_number: ENV["VERSION_NAME"]
    )

    # 6) Force manual code signing with the match profile. Capacitor's generated
    # Xcode project defaults to automatic signing, which ignores the profile
    # match just installed and tries to generate its own — impossible in CI
    # without an Apple ID login.
    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      targets: ["App"],
      bundle_identifier: bundle_id,
      profile_name: "match AppStore #{bundle_id}",
      code_sign_identity: "Apple Distribution",
      team_id: ENV["APPLE_TEAM_ID"]
    )

    # 7) Build + sign
    build_app(
      scheme: "App",
      workspace: "App.xcworkspace",
      export_method: "app-store",
      configuration: "Release",
      clean: true,
      output_directory: "./build",
      output_name: "App.ipa",
      export_options: {
        provisioningProfiles: {
          bundle_id => "match AppStore #{bundle_id}"
        }
      }
    )

    # 7) Upload to TestFlight. Si despues se envia a revision (lane
    # submit_review), hay que esperar a que Apple termine de procesar el build:
    # no se puede enviar uno que todavia esta "Processing".
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: ENV["SUBMIT_FOR_REVIEW"] != "true"
    )
  end

  # Envia a revision de App Store el build que acaba de subir `release`.
  #
  # Expects env vars: BUNDLE_ID, BUILD_NUMBER, VERSION_NAME, RELEASE_NOTES,
  # APPSTORE_API_KEY_ID, APPSTORE_API_ISSUER_ID.
  #
  # Crea la version (si no existe) con las notas de "Novedades" para todos los
  # idiomas de la ficha, elige el build y la envia. No toca capturas ni la
  # descripcion: la ficha publicada queda como esta.
  desc "Submit the uploaded build for App Store review"
  lane :submit_review do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_API_KEY_ID"],
      issuer_id: ENV["APPSTORE_API_ISSUER_ID"],
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey.p8"),
      in_house: false
    )
    notes = ENV["RELEASE_NOTES"].to_s.strip
    UI.user_error!("RELEASE_NOTES is required to submit for review") if notes.empty?

    bundle_id = ENV["BUNDLE_ID"]
    common = {
      api_key: api_key,
      app_identifier: bundle_id,
      app_version: ENV["VERSION_NAME"],
      build_number: ENV["BUILD_NUMBER"],
      platform: "ios",
      skip_binary_upload: true,
      skip_screenshots: true,
      # La ficha (descripcion, capturas) no se toca: sin carpeta de metadata,
      # deliver no sabria en que idiomas poner las notas (ver paso 2).
      skip_metadata: true,
      force: true, # sin el reporte HTML de confirmacion (CI no es interactivo)
      run_precheck_before_submit: false
    }

    # 1) Crear la version (si no existe) y asociarle el build.
    upload_to_app_store(common.merge(submit_for_review: false))

    # 2) "Novedades" en cada idioma de la ficha: Apple no deja enviar a revision
    # una version sin whatsNew en alguno de sus idiomas.
    require "spaceship"
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No se encontro la version editable #{ENV['VERSION_NAME']}") if version.nil?
    version.get_app_store_version_localizations.each do |localization|
      UI.message("Novedades para #{localization.locale}")
      localization.update(attributes: { whats_new: notes })
    end

    # 3) Enviar a revision.
    upload_to_app_store(common.merge(
      submit_for_review: true,
      submission_information: {
        # Solo HTTPS / cifrado estandar del sistema: exento de export compliance.
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false
      }
    ))
  end
  # Agrega un probador interno de TestFlight a la app principal. Los probadores
  # internos tienen que ser usuarios del equipo en App Store Connect; el grupo
  # tiene acceso a todos los builds, asi cada build nuevo les llega solo.
  #
  # Expects env vars: BUNDLE_ID, TESTER_EMAIL, (TESTER_FIRST_NAME, TESTER_LAST_NAME),
  # APPSTORE_API_KEY_ID, APPSTORE_API_ISSUER_ID.
  desc "Add an internal TestFlight tester"
  lane :add_tester do
    app_store_connect_api_key(
      key_id: ENV["APPSTORE_API_KEY_ID"],
      issuer_id: ENV["APPSTORE_API_ISSUER_ID"],
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey.p8"),
      in_house: false
    )
    email = ENV["TESTER_EMAIL"].to_s.strip
    UI.user_error!("TESTER_EMAIL is required") if email.empty?

    require "spaceship"
    app = Spaceship::ConnectAPI::App.find(ENV["BUNDLE_ID"])
    UI.user_error!("App #{ENV['BUNDLE_ID']} not found in App Store Connect") if app.nil?

    group_name = "Equipo Shopifree"
    group = app.get_beta_groups.find { |g| g.name == group_name }
    if group.nil?
      UI.message("Creando grupo interno '#{group_name}' con acceso a todos los builds…")
      group = app.create_beta_group(group_name: group_name, is_internal_group: true, has_access_to_all_builds: true)
    end

    UI.message("Agregando #{email} al grupo '#{group.name}'…")
    group.post_bulk_beta_tester_assignments(beta_testers: [{
      email: email,
      firstName: ENV["TESTER_FIRST_NAME"].to_s.empty? ? "Probador" : ENV["TESTER_FIRST_NAME"],
      lastName: ENV["TESTER_LAST_NAME"].to_s.empty? ? "Shopifree" : ENV["TESTER_LAST_NAME"]
    }])

    tester = app.get_beta_testers(filter: { email: email }).first
    UI.user_error!("Apple no registro al probador #{email}") if tester.nil?
    UI.success("#{email} agregado. Estado de la invitacion: #{tester.invite_type || 'enviada'}")
  end
end
