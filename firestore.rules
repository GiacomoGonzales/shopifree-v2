rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'giiacomo@gmail.com';
    }

    function isStoreOwner(storeId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    function isStoreOwnerOrAdmin(storeId) {
      return isStoreOwner(storeId) || isAdmin();
    }

    // Users collection - Admin can list all users
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId);

      // User subscriptions subcollection
      match /subscriptions/{subId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Only backend can write subscriptions
      }
    }

    // Stores collection
    match /stores/{storeId} {
      // Anyone can read store (public catalogs)
      allow read: if true;
      // Only authenticated users can create stores — as themselves, with a
      // client-settable plan limited to free/pro and the signup trial capped
      // at 8 days (7 + clock-skew headroom). planExpiresAt is an admin-only
      // comp field and can never be set from the client.
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && (isAdmin() || (
          (!('plan' in request.resource.data) || request.resource.data.plan in ['free', 'pro'])
          && (!('trialEndsAt' in request.resource.data) || (
            request.resource.data.trialEndsAt is timestamp
            && request.resource.data.trialEndsAt <= request.time + duration.value(8, 'd')
          ))
          && !('planExpiresAt' in request.resource.data)
          && !('subscription' in request.resource.data)
        ));
      // Owner can update everything EXCEPT billing-integrity fields — those
      // are only written by the Stripe webhook / trial crons (admin SDK
      // bypasses rules) or by the platform admin. Without this lock a free
      // store could self-assign plan:'business' or forge an active
      // subscription and keep Pro features forever.
      allow update: if isAdmin() || (
        isStoreOwner(storeId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plan', 'trialEndsAt', 'planExpiresAt', 'subscription', 'ownerId'])
      );
      allow delete: if isStoreOwnerOrAdmin(storeId);

      // Products subcollection
      match /products/{productId} {
        allow read: if true; // Public catalog
        allow create: if isStoreOwner(storeId);
        allow update: if isStoreOwner(storeId);
        allow delete: if isStoreOwner(storeId);
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if true; // Public
        allow create: if isStoreOwner(storeId);
        allow update: if isStoreOwner(storeId);
        allow delete: if isStoreOwner(storeId);
      }

      // Orders subcollection
      match /orders/{orderId} {
        allow read: if isStoreOwnerOrAdmin(storeId);
        allow create: if true; // Customers can create orders
        allow update: if isStoreOwner(storeId);
        allow delete: if isStoreOwner(storeId);
      }

      // Customers subcollection
      match /customers/{customerId} {
        allow read: if isStoreOwnerOrAdmin(storeId);
        allow create: if true; // Auto-created on order
        allow update: if isStoreOwner(storeId);
        allow delete: if isStoreOwner(storeId);
      }

      // Coupons subcollection
      match /coupons/{couponId} {
        allow read: if true; // Validate coupons publicly
        allow write: if isStoreOwner(storeId);
      }

      // Expenses subcollection (finance module)
      match /expenses/{expenseId} {
        allow read: if isStoreOwnerOrAdmin(storeId);
        allow create: if isStoreOwner(storeId);
        allow update: if isStoreOwner(storeId);
        allow delete: if isStoreOwner(storeId);
      }

      // Stock movements subcollection (finance module)
      match /stock_movements/{movementId} {
        allow read: if isStoreOwnerOrAdmin(storeId);
        allow write: if isStoreOwner(storeId);
      }

      // Suppliers subcollection (finance module)
      match /suppliers/{supplierId} {
        allow read: if isStoreOwnerOrAdmin(storeId);
        allow write: if isStoreOwner(storeId);
      }

      // Purchases subcollection (finance module)
      match /purchases/{purchaseId} {
        allow read: if isStoreOwnerOrAdmin(storeId);
        allow write: if isStoreOwner(storeId);
      }

      // Warehouses subcollection (finance module)
      match /warehouses/{warehouseId} {
        allow read: if isStoreOwnerOrAdmin(storeId);
        allow write: if isStoreOwner(storeId);
      }

      // Branches subcollection (finance module)
      match /branches/{branchId} {
        allow read: if isStoreOwnerOrAdmin(storeId);
        allow write: if isStoreOwner(storeId);
      }

      // Production orders subcollection (finance module)
      match /production_orders/{productionOrderId} {
        allow read: if isStoreOwnerOrAdmin(storeId);
        allow write: if isStoreOwner(storeId);
      }

      // Analytics subcollection
      match /analytics/{eventId} {
        allow read: if isStoreOwnerOrAdmin(storeId);
        allow create: if true; // Anyone can track events (page views, clicks)
        allow update, delete: if false; // Protect analytics data
      }
    }

    // Domain indexes (for lookups)
    match /domains/{domain} {
      allow read: if true;
      allow write: if false; // Only backend manages domains
    }

    // Subdomain claim registry — THE uniqueness lock for store subdomains.
    // create-only + update:false means the first writer wins and nobody can
    // overwrite an existing claim; storeService.create claims here BEFORE
    // creating the store doc. Keep update:false — it's load-bearing.
    match /subdomains/{subdomain} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Allow delete if user owns the store associated with this subdomain
      allow delete: if isAuthenticated() &&
        resource.data.storeId == request.auth.uid;
      allow update: if false;
    }

    // Plans (read-only for everyone)
    match /plans/{planId} {
      allow read: if true;
      allow write: if false; // Admin only
    }

    // Themes (read-only)
    match /themes/{themeId} {
      allow read: if true;
      allow write: if false; // Admin only
    }

    // Integrations (sensitive - owner only)
    match /integrations/{storeId} {
      allow read: if isStoreOwner(storeId);
      allow write: if false; // Only backend handles tokens
    }

    // Feedback from dashboard users
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Demo stores for landing carousel
    match /demoStores/{storeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Support chats (auto-generated IDs, userId field for ownership)
    match /chats/{chatId} {
      function isChatOwner() {
        return isAuthenticated() && resource.data.userId == request.auth.uid;
      }
      function isChatCreator() {
        return isAuthenticated() && request.resource.data.userId == request.auth.uid;
      }

      allow read: if isChatOwner() || isAdmin();
      allow create: if isChatCreator();
      allow update: if isChatOwner() || isAdmin();
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid || isAdmin();
        allow create: if get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid || isAdmin();
        allow update, delete: if false;
      }
    }
  }
}
